# Cloudflare D1 Database Configuration
# Obtain these from your Cloudflare Dashboard (dash.cloudflare.com)

# Your Cloudflare Account ID (Found in Workers & Pages or Dashboard URL)
CLOUDFLARE_ACCOUNT_ID=

# Your D1 Database ID (Found in Storage & Databases -> D1 SQL Database -> Your DB)
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare API Token with "Account.D1:Edit" permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_D1_API_TOKEN=

# ── Site ─────────────────────────────────────────────
# Production origin, used for canonical URLs, sitemap, robots and social cards.
NEXT_PUBLIC_SITE_URL=

# ── Spam protection (optional) ───────────────────────
# Cloudflare Turnstile. Leave both empty to disable the check.
# Create at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Inquiry notification email (optional) ────────────
# Resend API key and the inbox(es) that receive new inquiries (comma-separated).
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
