# ── MongoDB Atlas Configuration ──────────────────────
# Obtain your connection URI from MongoDB Atlas (cloud.mongodb.com):
# Database -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# Optional: target database name (defaults to 'krudex' or whatever is in MONGODB_URI)
MONGODB_DB=krudex

# ── Site ─────────────────────────────────────────────
# Production origin, used for canonical URLs, sitemap, robots and social cards.
NEXT_PUBLIC_SITE_URL=

# ── Spam protection (optional) ───────────────────────
# Cloudflare Turnstile. Leave both empty to disable the check.
# Create at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Inquiry notification email (optional) ────────────
# Resend API key and the inbox(es) that receive new inquiries (comma-separated).
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
